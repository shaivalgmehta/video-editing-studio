# Media and job data stay out of Git (keep them on local disk or a shared drive)
**/input/*
!**/input/.gitkeep
**/output/**
!**/output/**/
!**/output/**/.gitkeep
!**/output/**/*.md
!**/output/**/*.html
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.png
*.jpg
*.jpeg
*.gif
*.psd
*.ai
*.aep
*.pdf
*.docx
*.pptx

# Machine-local
.env
.env.*
.claude/settings.local.json
_shared/tools/venvs/
**/venv/
**/__pycache__/
**/node_modules/
**/.hyperframes/
**/renders/
**/tmp/
**/snaps*/

# Installed per machine by setup.ps1 (npx skills add heygen-com/hyperframes)
.agents/
.claude/skills/figma
.claude/skills/hyperframes
.claude/skills/hyperframes-cli
.claude/skills/hyperframes-registry
.claude/skills/media-use
.claude/skills/remotion-to-hyperframes
.claude/skills/slideshow
